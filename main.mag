# MAIN.MAG - BOOT ENTRYPOINT & COMPILER TRIGGER
# Transact & Etelia Bridge Engine

import "matrix.mag"
import "ingestion/multi_parser.mag"
import "ingestion/security_scanner.mag"
import "ingestion/telemetry_logger.mag"

[BOOTSTRAP]
trigger "InitializeBridgeEngine" {
  log "Starting Transact & Etelia Bridge Engine..."
  scan_source_directory("./ingestion")
  apply_bridges()
  seal_with_ulma()
  export_to_dist()
  log "Transmutation completed successfully. Zero crashes detected."
}
